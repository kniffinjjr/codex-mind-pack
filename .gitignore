*.pyc
.venv/
venv/
node_modules/
dist/
build/

# Optional: uncomment to keep all active projects local-only (never push to public origin)
# Projects/*/
# !Projects/_template/
# !Projects/_index.md
# !Projects/README.md

# Logs and temp
*.log
tmp/
.temp/
